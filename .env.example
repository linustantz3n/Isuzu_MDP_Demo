# Copy these settings into the backend .env beside route_optimizer_backend.py.
# Keep real keys in .env, which is ignored by Git. Restart the backend after edits.

# Live Google features; optional for run_demo.py.
GOOGLE_MAPS_API_KEY=

# Natural-language chat. Fixed driver commands work without an LLM key.
# The endpoint/model must support Chat Completions and strict JSON Schema output.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# For another provider, replace the base URL and model with its supplied values.
# Do not append /chat/completions; the backend adds that path automatically.
